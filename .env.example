# Namaste Bharat Inn — environment variables
# Copy to .env for local use, or set these in Vercel → Project → Settings → Environment Variables.

# --- Database (production) ---
# Create a free DB at https://turso.tech then run `turso db show --url <name>`
# and `turso db tokens create <name>`. Leave BOTH unset for local file DB.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---
# Long random string used to sign session tokens. REQUIRED in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: override the seeded default passwords (used by `npm run seed`
# and first-run auto-seed). Change the passwords from Settings after login.
OWNER_PASSWORD=owner123
MANAGER_PASSWORD=manager123

# --- Razorpay (optional — leave blank for Test Mode) ---
# From Razorpay Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
